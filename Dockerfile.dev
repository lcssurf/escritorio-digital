# Para quem desenvolve: só o nosso código Python por cima da nossa imagem completa, em segundos (sem refazer o resto).
#   docker build -f Dockerfile.dev -t escritorio-digital:dev .
# A base é a nossa própria imagem (a que a instalação baixa). Para trocar: --build-arg BASE=...
ARG BASE=ghcr.io/lcssurf/escritorio-digital:1.0.1
FROM ${BASE}
USER root
COPY pyproject.toml README.md /src/
COPY clodfarm /src/clodfarm
RUN /opt/clodfarm/bin/pip install --no-cache-dir /src && rm -rf /src
USER farm
