# A nossa parte (o código do escritório) em cima da imagem do clodfarm original, em segundos.
#   node scripts/escritorio.mjs construir          (é o que a instalação usa)
#   docker build -f Dockerfile.dev -t escritorio-digital:dev .
# A base já traz o Claude Code, o Node, o Chromium e o resto, na versão em que a nossa cópia se baseia (fixada, para uma
# atualização deles não quebrar o nosso código). Para montar tudo do zero (mais lento): docker build -t escritorio-digital:dev .
ARG BASE=ghcr.io/matank001/clodfarm:1.12.0
FROM ${BASE}
USER root
COPY pyproject.toml README.md /src/
COPY clodfarm /src/clodfarm
RUN /opt/clodfarm/bin/pip install --no-cache-dir /src && rm -rf /src
USER farm
